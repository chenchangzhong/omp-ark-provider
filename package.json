{
  "name": "omp-ark-provider",
  "version": "0.1.2",
  "description": "OMP provider extension for Ark Agent Plan API.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "omp-package",
    "omp-provider",
    "volcengine",
    "ark",
    "plan"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/MacroSony/omp-ark-provider.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.79.2",
    "@types/node": "24.12.4",
    "esbuild": "^0.28.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
